{
  "expo": {
    "name": "Verve",
    "slug": "verve",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "verve",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C0E14"
    },
    "ios": {
      "bundleIdentifier": "com.verve.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Verve uses the local network to sync data with your workstation CLI.",
        "NSBonjourServices": ["_verve._tcp"]
      }
    },
    "android": {
      "package": "com.verve.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0C0E14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.WRITE_HEART_RATE",
        "android.permission.USE_GENAI_CORE_INFRASTRUCTURE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Verve tracks HR to monitor your cognitive load during deep work.",
          "NSHealthUpdateUsageDescription": "Verve records workstation-aligned biometric data."
        }
      ],
      [
        "react-native-health-connect",
        {
          "permissions": ["HeartRate"]
        }
      ],
      "./plugins/withLargeHeap",
      "./plugins/withHealthConnectPermissionDelegate",
      "./plugins/withSystemAI",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      "expo-sqlite",
      [
        "llama.rn",
        {
          "enableOpenCLAndHexagon": true,
          "forceCxx20": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "49a6af1d-6484-4124-9423-6bc213d1e627"
      }
    },
    "owner": "gyandeeps",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/49a6af1d-6484-4124-9423-6bc213d1e627",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 30000
    }
  }
}
