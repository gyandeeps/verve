    "web": "EXPO_NO_TELEMETRY=1 expo start --web",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,mjs,css,html}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,mjs,css,html}\"",
    "bump-version": "node ./scripts/bump-version.mjs && npm install",
    "test": "npx tsc --noEmit"
  },
